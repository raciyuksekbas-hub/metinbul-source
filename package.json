{
  "name": "metinbul",
  "productName": "MetinBul",
  "version": "0.4.4",
  "description": "DOC, DOCX, PDF ve UDF belgelerinde yerel metin arama utility'si",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs && electron dist/main.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:mac": "npm run build && electron-builder --mac --publish=never",
    "package:win": "npm run build && electron-builder --win --publish=never",
    "release:mac": "node scripts/mac-release.mjs",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:audit": "npm audit --audit-level=critical && npm audit --omit=dev --audit-level=info && npm audit --json | node scripts/security/audit-electron.mjs",
    "package": "npm run package:mac"
  },
  "keywords": [
    "search",
    "desktop",
    "fts5",
    "docx",
    "pdf",
    "udf",
    "doc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "fast-xml-parser": "^5.12.0",
    "mammoth": "^1.11.0",
    "pdf-parse": "^2.4.5",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.0",
    "@types/pdf-parse": "^1.1.5",
    "adm-zip": "^0.6.1",
    "electron": "^43.8.8",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.metinbul.app",
    "productName": "MetinBul",
    "copyright": "Copyright © 2026 Raci Çetin Yüksekbaş",
    "compression": "maximum",
    "npmRebuild": false,
    "afterPack": "scripts/electron-fuses.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/native/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extraResources": [
        {
          "from": "dist/native/metinbul-ocr",
          "to": "bin/metinbul-ocr"
        }
      ]
    },
    "dmg": {
      "sign": true,
      "artifactName": "${productName}-${version}-mac.dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "executableName": "MetinBul"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MetinBul"
    }
  }
}
